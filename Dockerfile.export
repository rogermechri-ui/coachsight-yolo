# Moteur d'export de clips sans carte graphique (tache export_clips seulement).
# Image legere : Python + ffmpeg (libx264) + police pour les cartons titre.
# A construire sur RunPod avec « Dockerfile path = Dockerfile.export » sur un
# endpoint CPU. Rien de YOLO, rien de CUDA.
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-export.txt constraints-export.txt ./
RUN pip install --no-cache-dir -c constraints-export.txt -r requirements-export.txt
# Liste des versions reellement installees, visible dans le journal de construction.
RUN echo "PIP_FREEZE_BEGIN" && python --version && pip freeze && echo "PIP_FREEZE_END" && (ffmpeg -version | head -1)
COPY safe.py export.py hls.py audio.py clipsai.py soundmoments.py handler_export.py ./
# Le moteur tourne sans droits administrateur (lot 3b, partie 2) : le compte lit /app
# et n'ecrit que dans /tmp et son dossier personnel.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin coach
ENV HOME=/home/coach
USER coach
CMD ["python", "-u", "handler_export.py"]
